# Copia este fichero como .env y cambia los valores
DB_PASSWORD=cambia-esta-contraseña-larga
# contraseña que usará la gente del gaztetxe para entrar en la app
APP_PASSWORD=cambia-esto
# opcional: si se pone, solo con esta contraseña se pueden editar productos, ajustes, borrar o restaurar copias
ADMIN_PASSWORD=
# opcional: cadena aleatoria larga para firmar las sesiones (openssl rand -hex 32)
TOKEN_SECRET=
# opcional: lectura automática de facturas con IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=
HTTP_PORT=8080
